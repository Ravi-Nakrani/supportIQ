# SupportIQ Frontend Configuration (Public Client)
# Note: Variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER place API keys, database credentials, or server secrets in this file.

# Optional: Base URL for backend API requests.
# If unset or empty, the frontend uses relative path '/api', which works with
# Vite's dev proxy or when hosted on the same origin / reverse-proxy rewrite.
# Example for decoupled production:
# VITE_API_BASE_URL=https://supportiq-backend.onrender.com/api
VITE_API_BASE_URL=

