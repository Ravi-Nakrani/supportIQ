{
  "name": "supportiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"npm run dev --workspace=@supportiq/backend\" \"npm run dev --workspace=@supportiq/frontend\"",
    "dev:backend": "npm run dev --workspace=@supportiq/backend",
    "dev:frontend": "npm run dev --workspace=@supportiq/frontend",
    "ingest:knowledge-base": "npm run ingest:knowledge-base --workspace=@supportiq/backend --",
    "build": "npm run build --workspaces",
    "build:all": "npm run build --workspaces",
    "start": "npm run start --workspace=@supportiq/backend",
    "verify:bundle-security": "node scripts/verify-bundle-security.js",
    "test": "npm run test --workspaces",
    "type-check": "npm run type-check --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

