# SupportIQ — Environment Configuration Template
# Copy this file to backend/.env for local backend development.
# Do not commit real credentials or .env files to source control.

# Application Runtime
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Future Integration Placeholders (Not required in Phase 1)
# Phase 3: MongoDB Atlas Vector Search
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=supportiq
# MONGODB_VECTOR_COLLECTION=knowledge_chunks
# MONGODB_VECTOR_INDEX_NAME=supportiq_vector_index

# Phase 3 & 4: OpenAI API Models & Credentials
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Phase 4: LLM Generation Parameters
# LLM_TEMPERATURE=0.0
# LLM_REASONING_EFFORT=none
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_TIMEOUT_MS=6000
# LLM_MAX_RETRIES=1

# Phase 3: Retrieval Bounds & Thresholds
# RETRIEVAL_DEFAULT_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.65
# RETRIEVAL_TIMEOUT_MS=2500

# Phase 6: Rate Limiting & Safety Budgets
# MAX_MESSAGE_CHARS=1000
# MAX_HISTORY_MESSAGES=6
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_MAX_REQUESTS=10

# Frontend Configuration (Public only, never place secrets here)
# VITE_API_BASE_URL=http://localhost:4000/api

