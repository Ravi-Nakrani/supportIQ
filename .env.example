# SupportIQ — Environment Configuration Template
# Copy this file to backend/.env for local backend development.
# Do not commit real credentials or .env files to source control.

# Application Runtime
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Future Integration Placeholders (Not required in Phase 1)
# Phase 3: MongoDB Atlas Vector Search
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=supportiq
# MONGODB_VECTOR_COLLECTION=knowledge_chunks
# MONGODB_VECTOR_INDEX_NAME=supportiq_vector_index

# Phase 3 & 4: OpenAI API Models & Credentials
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Phase 4: LLM Generation Parameters
# LLM_TEMPERATURE=0.0
# LLM_REASONING_EFFORT=none
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_TIMEOUT_MS=6000
# LLM_MAX_RETRIES=1

# Phase 3: Retrieval Bounds & Thresholds
# RETRIEVAL_DEFAULT_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.65
# RETRIEVAL_TIMEOUT_MS=2500

# Phase 6 & Phase 8: Rate Limiting & Safety Budgets
# MAX_MESSAGE_CHARS=1000
# MAX_HISTORY_MESSAGES=6
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_MAX_REQUESTS=10
# DAILY_MAX_REQUESTS=200
# DAILY_MAX_TOKENS=200000
# DAILY_MAX_BUDGET_MICRO_USD=5000000
# CHAT_CONCURRENCY_LIMIT=5
# MONGODB_USAGE_COLLECTION=daily_usage

# Reverse Proxy Trust Configuration:
# Keep false by default to prevent client IP spoofing.
# Set strictly according to verified upstream proxy chain (e.g. 1 for single cloud proxy, or explicit subnet).
TRUST_PROXY=false

# Phase 8: Static Frontend Serving from Express
# Set to true in production if running as a unified single service or container
SERVE_STATIC_FRONTEND=false

# Frontend Configuration (Public client only; never place secrets here)
# VITE_API_BASE_URL=http://localhost:4000/api

