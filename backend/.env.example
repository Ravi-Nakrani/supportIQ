# SupportIQ Backend Configuration
# Copy this file to .env and adjust variables as needed.

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# The following variables will be required in later phases:
# Phase 3: MongoDB Atlas Vector Search
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=supportiq
# MONGODB_VECTOR_COLLECTION=knowledge_chunks
# MONGODB_VECTOR_INDEX_NAME=supportiq_vector_index

# Phase 3 & 4: OpenAI API Credentials & Models
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Phase 3: Retrieval Bounds & Thresholds
# RETRIEVAL_DEFAULT_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.65
# RETRIEVAL_TIMEOUT_MS=2500

# Phase 6: Rate Limiting & Bounds
# MAX_MESSAGE_CHARS=1000
# MAX_HISTORY_MESSAGES=6
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_MAX_REQUESTS=10

